# MongoDB Database Connection String
MONGODB_URI="mongodb://127.0.0.1:27017/bookhaven"

# JWT Secret Key
JWT_SECRET="bookhaven_jwt_secret_production_ready_key_2026"

# Optional: Google Books API Key
GOOGLE_BOOKS_API_KEY=""

# Public URL used to build OAuth callback URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js (NextAuth) secret — used to sign OAuth sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google OAuth credentials (Auth.js)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Production: https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend email delivery (create an API key at https://resend.com/api-keys)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
